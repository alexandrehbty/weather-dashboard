# =============================================================================
# GEOMETEO - MODÈLE DE CONFIGURATION TERRAFORM
# =============================================================================
# 1. Copiez ce fichier dans le dossier du fournisseur choisi :
#    cp ../terraform.tfvars.example ./terraform.tfvars
# 2. Renseignez image_url et décommentez UNIQUEMENT la section du fournisseur.
# 3. Ne commitez jamais terraform.tfvars (déjà exclu dans .gitignore).
# =============================================================================

# --- VARIABLES COMMUNES ---
# Recommandé : injectez la clé en mémoire plutôt que sur disque :
#   export TF_VAR_openweather_api_key="votre_cle_api"
# (Laissez la ligne ci-dessous commentée si vous utilisez TF_VAR_*,
# car terraform.tfvars est toujours prioritaire.)
# openweather_api_key = "votre_cle_api_ici"

# Image Docker publique par défaut (compatible Alibaba, Azure, Hetzner, Oracle, OVH, Scaleway)
image_url = "ghcr.io/votre-pseudo/weather-dashboard:main"

# --- ALIBABA CLOUD (optionnel — défaut : eu-central-1) ---
# region = "eu-central-1"

# --- AWS (ECR Public obligatoire pour App Runner — remplacer image_url ci-dessus) ---
# region    = "eu-west-3"
# image_url = "public.ecr.aws/votre-alias/weather-dashboard:latest"

# --- AZURE (optionnel — défaut : francecentral) ---
# location = "francecentral"

# --- GCP (project_id obligatoire + Artifact Registry requis) ---
# project_id = "votre-id-projet-google"
# region     = "europe-west9"
# image_url  = "europe-west9-docker.pkg.dev/votre-projet/votre-repo/weather-dashboard:main"

# --- HETZNER (hcloud_token optionnel si HCLOUD_TOKEN est exporté) ---
# hcloud_token      = "votre_token_hetzner"
# location          = "fsn1"
# ssh_public_key    = "ssh-ed25519 AAAA..."
# ssh_allowed_cidrs = ["VOTRE_IP/32"]

# --- ORACLE CLOUD (compartment_ocid obligatoire) ---
# compartment_ocid = "ocid1.compartment.oc1..."
# region           = "eu-paris-1"

# --- OVHcloud (identifiants optionnels si openrc.sh est sourcé) ---
# openstack_user_name   = "votre_user"
# openstack_password    = "votre_password"
# openstack_tenant_name = "votre_nom_de_projet"
# region                = "GRA11"
# ssh_public_key        = "ssh-ed25519 AAAA..."
# ssh_allowed_cidrs     = ["VOTRE_IP/32"]

# --- SCALEWAY (optionnel — défaut : fr-par) ---
# region = "fr-par"